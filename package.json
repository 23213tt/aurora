{
  "name": "aurora-player",
  "private": true,
  "version": "0.1.0",
  "description": "本地优先的 Windows 音乐播放器：沉浸歌词舞台、封面主色驱动配色、可选接入网易云在线音源",
  "author": "Aurora contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/23213tt/aurora.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && vite build",
    "preview": "vite build --config vite.preview.config.ts && vite build --config vite.preview-overlay.config.ts && node scripts/inline-preview.mjs",
    "perf": "node scripts/perf-report.mjs",
    "icons": "node scripts/make-icons.mjs",
    "asar": "node scripts/asar-probe.mjs",
    "scan": "node scripts/scan-probe.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.aurora.player",
    "productName": "Aurora",
    "copyright": "Copyright © 2026 23213tt",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/music-metadata/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "23213tt",
      "repo": "aurora"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurora",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "^4.41.1",
    "music-metadata": "^11.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.0"
  }
}
